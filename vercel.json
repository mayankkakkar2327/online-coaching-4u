{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node website-src/fetch-remote.js && node website-src/build.js",
  "outputDirectory": "website",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/schools-jhunjhunu",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/institute-aci-senior-secondary-school-jhunjhunu",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/institute-jhunjhunu-academy-gaushala-road",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/institute-shri-saraswati-sr-sec-school-udaipurwati",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(admin|institute)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/portal/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/assets/(style.css|app.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
